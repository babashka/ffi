{:paths ["src" "resources"]
 :aliases
 {:test {:extra-paths ["test" "test-jvm"]
         ;; fs and process are built into babashka; the JVM run needs them
         ;; as deps so one test file covers both hosts
         :extra-deps {babashka/fs {:mvn/version "0.5.34"}
                      babashka/process {:mvn/version "0.6.25"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1"
                       :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :jvm-opts ["--enable-native-access=ALL-UNNAMED"]
         :main-opts ["-m" "cognitect.test-runner" "-d" "test" "-d" "test-jvm"]
         :exec-args {:dirs ["test" "test-jvm"]}
         :exec-fn cognitect.test-runner.api/test}
  ;; the Node.js host, compiled with ClojureScript. Needs JDK 25 or newer,
  ;; because the compiler loads the macros from ffi.clj.
  :cljs-test {:extra-deps {olical/cljs-test-runner {:mvn/version "3.8.1"}
                           org.clojure/clojurescript {:mvn/version "1.12.145"}}
              :extra-paths ["test-node" "cljs-test-runner-out/gen"]
              :main-opts ["-m" "cljs-test-runner.main" "-d" "test-node"]}}}
