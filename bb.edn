{:paths ["src" "bb"]
 :deps {io.github.borkdude/quickdoc
        #_{:local/root "/Users/borkdude/dev/quickdoc"}
        {:git/sha "5097746c91fbd6605792e7dc817a81d20b8d691a"}
        ;; tools.build itself is built into babashka, so build.clj runs here
        io.github.babashka/deps-deploy {:mvn/version "0.0.1"}}
 :tasks
 {test:bb {:doc "Run the tests through babashka's built-in babashka.ffi."
           :extra-paths ["test"]
           :extra-deps {io.github.cognitect-labs/test-runner
                        {:git/tag "v0.5.1"
                         :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
           :task (exec 'cognitect.test-runner.api/test)
           :exec-args {:dirs ["test"]}
           :org.babashka/cli {:coerce {:nses [:symbol] :vars [:symbol]}}}
  test:jvm {:doc "Run the tests on the JVM."
            :task (shell "clojure -M:test")}
  test:node {:doc "Run the Node.js tests with nbb. Needs Node.js 26.1 or newer on PATH."
             :requires ([babashka.fs :as fs])
             :task (shell "npx" "--yes" "nbb@1.5.212"
                          "--classpath" (str "src" fs/path-separator "test-node")
                          "-m" "babashka.ffi-test")}
  test:native {:doc "Build a native image of babashka.ffi and run test-native against it. Needs GRAALVM_HOME."
               :task (do (load-file "script/native_test.clj")
                         ((resolve 'native-test/-main)))}
  test:cljs {:doc "Run the Node.js tests compiled with ClojureScript. Pass advanced for an :advanced build."
             :requires ([babashka.fs :as fs])
             :task (if (= "advanced" (first *command-line-args*))
                     (let [opts (str (fs/create-temp-file {:suffix ".edn"}))]
                       (spit opts "{:optimizations :advanced :infer-externs true}")
                       (clojure "-M:cljs-test" "-c" opts))
                     (clojure "-M:cljs-test"))}
  test:shadow {:doc "Run the Node.js tests compiled with shadow-cljs, plain and :advanced."
               :task (do (shell "npm" "install")
                         (shell "npx" "shadow-cljs" "compile" "node-test" "node-test-advanced")
                         (shell "node" "target/shadow/node-tests.js")
                         (shell "node" "target/shadow/node-tests-advanced.js"))}
  quickdoc
  {:doc "Invoke quickdoc"
   :requires ([quickdoc.api :as api])
   ;; the task body is evaluated, so the override map is quoted. The vars
   ;; a deftype generates are not API: the constructor is private at run
   ;; time, which static analysis cannot see.
   ;; API.md lists the JVM namespace. ffi.cljs has the same name.
   :task (api/quickdoc {:source-paths ["src/babashka/ffi.clj"]
                        :git/branch "main"
                        :github/repo "https://github.com/babashka/ffi"
                        :overrides (quote {babashka.ffi {->Place {:no-doc true}
                                                         Place {:no-doc true}
                                                         ->Binding {:no-doc true}
                                                         Binding {:no-doc true}}})
                        :toc true
                        :var-links true
                        :var-pattern :wikilinks})}

  bump-release
  {:doc "Bump the release counter, turn the Unreleased changelog header into the new version, commit, tag and push the tag"
   :requires ([clojure.string :as str]
              [utils])
   :task (let [old-version (utils/format-version)
               changelog (slurp "CHANGELOG.md")]
           (when-not (str/includes? changelog "## Unreleased")
             (throw (ex-info "CHANGELOG.md has no ## Unreleased header" {})))
           (utils/bump-version)
           (let [new-version (utils/format-version)]
             (spit "CHANGELOG.md" (str/replace-first changelog
                                                     "## Unreleased"
                                                     (str "## " new-version)))
             (spit "README.md" (str/replace (slurp "README.md") old-version new-version))
             (shell "git add version.edn README.md CHANGELOG.md")
             (shell "git commit -m" (str "v" new-version))
             (shell "git tag" (str "v" new-version))
             (shell "git push --tags")))}

  publish
  {:doc "Build the jar and deploy it to Clojars. Pass --bump to bump the release counter first"
   :extra-paths ["."]
   :exec-fn tasks/publish}}}
